# Copy this file to .env and fill in your values.
# api_id and api_hash are generated at https://my.telegram.org/apps

TG_API_ID=11111111
TG_API_HASH=0123456789abcdef0123456789abcdef
# Optional: pre-fill the phone so the first login only asks for the code
TG_PHONE=+5511999999999
# Optional: your 2FA password, if the account has one
TG_PASSWORD=
